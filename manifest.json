{
  "name": "finch-music",
  "description": "听音乐上 finch",
  "author": "sigoden@gmail.com",
  "manifest_version": 3,
  "homepage_url" : "https://github.com/sigoden/netease-music-crx" ,
  "background": {
    "service_worker": "service-worker.bundle.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon-34.png"
  },
  "icons": {
    "128": "icon-128.png",
    "48" : "icon-128.png",
    "16" : "icon-128.png"
  },
  "permissions": [
    "storage",
    "offscreen",
    "cookies",
    "contextMenus",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://music.163.com/*",
    "*://*.music.163.com/*"
  ],
  "update_url": "http://clients2.google.com/service/update2/crx",
  "minimum_chrome_version": "109",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "playNext": {
      "suggested_key": {
        "default": "MediaNextTrack",
        "windows": "MediaNextTrack",
        "mac": "MediaNextTrack",
        "linux": "MediaNextTrack"
      },
      "description": "Play Next",
      "global": true
    },
    "playPrev": {
      "suggested_key": {
        "default": "MediaPrevTrack",
        "windows": "MediaPrevTrack",
        "mac": "MediaPrevTrack",
        "linux": "MediaPrevTrack"
      },
      "description": "Play Previous",
      "global": true
    },
    "togglePlaying": {
      "suggested_key": {
        "default": "MediaPlayPause",
        "windows": "MediaPlayPause",
        "mac": "MediaPlayPause",
        "linux": "MediaPlayPause"
      },
      "description": "Play Pause",
      "global": true
    }
  }
}
